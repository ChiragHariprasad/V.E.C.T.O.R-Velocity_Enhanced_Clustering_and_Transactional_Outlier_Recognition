# =============================================================================
# V.E.C.T.O.R Frontend — Vite Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for local development.
# For Vercel production builds, set VITE_API_BASE_URL in the Vercel project
# dashboard under Settings → Environment Variables.
#
# ⚠️  VITE_ variables are public — they are embedded in the browser bundle at
#     build time. NEVER place secrets, Atlas credentials, or write tokens here.
# =============================================================================

# ─── Backend API Origin ──────────────────────────────────────────────────────
# Base origin only (no "/api", no trailing slash).
# Development default (used automatically if omitted): http://localhost:3001
#
# For Vercel production builds:
#   VITE_API_BASE_URL=https://<your-render-service>.onrender.com
#
# Vite environment variables are injected at BUILD TIME.
# Changing this value requires a new Vercel deployment.
VITE_API_BASE_URL=http://localhost:3001
