# =============================================================================
# V.E.C.T.O.R Backend — Environment Configuration Template
# Velocity Enhanced Clustering and Transactional Outlier Recognition
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit secrets, passwords, or production credentials to source control.
#
# ─── Where each variable belongs ─────────────────────────────────────────────
#   RENDER (Backend)  — all variables below unless noted
#   VERCEL (Frontend) — ONLY VITE_API_BASE_URL (see Frontend/.env.example)
# =============================================================================

# ─── Node.js Server & Network Configuration ──────────────────────────────────
# Port on which the Express REST API and Socket.IO server listen.
# Render injects $PORT at runtime — do not hardcode a specific port for Render.
PORT=3001

# Node environment: 'development' or 'production'
NODE_ENV=production

# Comma-separated exact browser origins for CORS. Do not use * for public
# deployments. For local dev, the Vite default ports are 5173 and 5174.
# For the hosted demo, set the exact Vercel production URL, e.g.:
#   CORS_ORIGIN=https://your-project.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ⚠️  VITE_API_BASE_URL is browser-visible. It is ONLY used by Vercel during
# the frontend build. Do NOT set secrets in VITE_ variables.
# VITE_API_BASE_URL=http://localhost:3001

# Polling interval fallback in milliseconds if MongoDB change streams are unavailable
TXN_POLL_MS=2000

# Path to Python executable used for analytical subprocesses.
# In Docker, this is typically 'python3'.
PYTHON_PATH=python

# ─── Write Protection ───────────────────────────────────────────────────────
# Mutating endpoints are read-only unless explicitly enabled. Production writes
# additionally require a strong bearer token. Keep this true for public demos.
DEMO_READ_ONLY=true
API_WRITE_TOKEN=
JSON_BODY_LIMIT=2mb
WRITE_RATE_LIMIT=10
WRITE_RATE_WINDOW_MS=60000

# ─── MongoDB Configuration ───────────────────────────────────────────────────
# MongoDB connection URI. For local dev: mongodb://127.0.0.1:27017
# For Atlas: mongodb+srv://<user>:<password>@<cluster>/<options>
# ⚠️  Never commit Atlas credentials to this file.
MONGO_URI=mongodb://127.0.0.1:27017

# Primary application database name
MONGO_DB_NAME=RedisTransactions

# ─── Demo Seeding ────────────────────────────────────────────────────────────
# Set to 'true' to seed synthetic demo data on first startup when collections
# are empty. Ordinary restarts will not duplicate data (idempotent check).
# This does NOT delete existing data — a destructive reseed requires the
# standalone CLI scripts in Frontend/server/.
SEED_DEMO_DATA=true

# ─── Bitcoin Core Configuration ─────────────────────────────────────────────
# True selects an explicit simulation state without contacting Bitcoin Core.
# Setting this to false does NOT enable live Bitcoin monitoring — it only
# causes the status endpoint to attempt an RPC probe, which will report
# DISCONNECTED without a running Bitcoin Core node.
BITCOIN_SIMULATION_MODE=true

# Bitcoin Core RPC (ignored when BITCOIN_SIMULATION_MODE=true)
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASSWORD=rpcpassword

# ─── Redis Configuration (Optional / Pipeline Caching) ──────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── ML Model Directory ──────────────────────────────────────────────────────
# Relative or absolute path to serialized scikit-learn/UMAP/HDBSCAN model artifacts
MODEL_DIR=Backend/bitcoin/models
